# Read these in your shell/CI secret store. MemoryCheck does not automatically load .env.
# A dedicated synthetic-test Mem0 configuration file; never a production config.
MEMORYCHECK_MEM0_CONFIG=/absolute/path/to/mem0-config.json
# Keep credentials out of pyproject.toml and traces.
MEMORYCHECK_POSTGRES_DSN=postgresql://test_user:test_password@localhost:5432/memorycheck_test
# Provider SDK telemetry/logging is controlled by the provider, not by MemoryCheck.
